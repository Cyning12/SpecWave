{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Cyning12/SpecWave/assets/ide/host-adapt/host-adapt.schema.json",
  "title": "DSH host-adapt table",
  "description": "Declarative host adaptation table (F6 / 2.x W1 · 3.0 W1 schema_version=2 additive). Surfaces: always_on, skills, commands; optional verify + hooks (3.0 W1: declaration only, materialization lands in W2). v2 adds schema_version / defaults / host-level extends (scalar override, object deep-merge, array replace; cycles/unknown targets/depth>8 rejected) and REQUIRES root command_sets (F-W1-07 fail-closed; forbidden entries kit-30/kit-publish always rejected in core/expanded, table-declared forbidden unions on top). hooks enums: mechanism shell-hook|config-hook|none; triggers pre-commit|pre-archive (none must not carry triggers/command; non-none requires both — enforced on resolved rows). target / target_dir must not hit S2_TRUTH_PREFIXES. AUTHORITATIVE validation is the handwritten CLI validator (src/host/schema.ts, npx spec-wave host validate); this JSON schema tracks it best-effort (merge-level partials and resolved-row completeness cannot be fully expressed here).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "hosts"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Table content version string (unchanged, e.g. \"1\"). Not the schema probe key."
    },
    "schema_version": {
      "type": "integer",
      "enum": [
        2
      ],
      "description": "3.0 W1 schema probe key (integer). Absent = v1 legacy flat semantics; 2 = v2 (defaults/extends resolution). Values >2 fail-closed."
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "command_sets": {
      "$ref": "#/$defs/CommandSets"
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/HostRow"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "schema_version"
          ]
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "defaults"
              ]
            },
            {
              "required": [
                "command_sets"
              ]
            }
          ]
        },
        "description": "v1 tables (no schema_version key) must not declare v2-only defaults / command_sets (handwritten validator rejects extends on v1 rows likewise)."
      }
    },
    {
      "if": {
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "required": [
          "command_sets"
        ],
        "description": "v2 tables must declare command_sets (F-W1-07 fail-closed · no hardcoded fallback)."
      }
    }
  ],
  "$defs": {
    "HostRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_id"
      ],
      "anyOf": [
        {
          "required": [
            "extends"
          ]
        },
        {
          "required": [
            "surfaces"
          ]
        }
      ],
      "properties": {
        "host_id": {
          "type": "string",
          "minLength": 1,
          "description": "Host identifier (e.g. dsh, cursor, claude). Unique per table in v2 (extends target ambiguity is rejected by the CLI validator)."
        },
        "extends": {
          "type": "string",
          "minLength": 1,
          "description": "v2 only: inherit another host_id or \"defaults\" (topological resolution; cycles/unknown targets rejected)."
        },
        "surfaces": {
          "$ref": "#/$defs/Surfaces"
        }
      }
    },
    "Defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "v2 only: pseudo-node for shared partial surfaces (referenced via extends: \"defaults\"). Defaults itself must not extends.",
      "properties": {
        "surfaces": {
          "$ref": "#/$defs/SurfacesPartial"
        }
      }
    },
    "CommandSets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "expanded"
      ],
      "description": "v2 only (F-W1-07 required): command verb catalog replacing hardcoded lists. forbidden unions with builtin kit-30/kit-publish (always rejected in core/expanded — enforced by the CLI validator).",
      "properties": {
        "core": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expanded": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "Surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "always_on",
        "skills",
        "commands"
      ],
      "properties": {
        "always_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlwaysOnEntry"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirFromEntry"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandsEntry"
          }
        },
        "verify": {
          "$ref": "#/$defs/VerifyEntry"
        },
        "hooks": {
          "$ref": "#/$defs/HooksEntry"
        }
      }
    },
    "SurfacesPartial": {
      "type": "object",
      "additionalProperties": false,
      "description": "v2 partial surfaces (defaults / rows with extends): any subset of sections; completeness is checked on resolved rows by the CLI validator.",
      "properties": {
        "always_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AlwaysOnEntry"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DirFromEntry"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CommandsEntry"
          }
        },
        "verify": {
          "$ref": "#/$defs/VerifyEntryPartial"
        },
        "hooks": {
          "$ref": "#/$defs/HooksEntry"
        }
      }
    },
    "HooksEntry": {
      "type": "object",
      "additionalProperties": false,
      "description": "3.0 W1 declaration-only hooks (materialization lands in W2). mechanism enum fail-closed; mechanism none must not carry triggers/command; non-none requires triggers (non-empty) + command — enforced on resolved rows by the CLI validator (merge levels may be partial).",
      "properties": {
        "mechanism": {
          "type": "string",
          "enum": [
            "shell-hook",
            "config-hook",
            "none"
          ]
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pre-commit",
              "pre-archive"
            ]
          }
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AlwaysOnEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "source"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DirFromEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_dir",
        "from"
      ],
      "properties": {
        "target_dir": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "CommandsEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_dir",
        "from"
      ],
      "properties": {
        "target_dir": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "core",
            "expanded",
            "custom"
          ]
        }
      }
    },
    "VerifyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bin"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "cli"
        },
        "bin": {
          "type": "string",
          "minLength": 1
        },
        "failClosed": {
          "type": "boolean"
        }
      }
    },
    "VerifyEntryPartial": {
      "type": "object",
      "additionalProperties": false,
      "description": "v2 partial verify for merge levels (deep-merge per key); kind/bin completeness checked on resolved rows.",
      "properties": {
        "kind": {
          "type": "string",
          "const": "cli"
        },
        "bin": {
          "type": "string",
          "minLength": 1
        },
        "failClosed": {
          "type": "boolean"
        }
      }
    }
  }
}
